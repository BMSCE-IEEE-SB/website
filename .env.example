# ==============================================================================
# BMSCE IEEE Student Branch Website - Environment Variables
# ==============================================================================
# Copy this file to .env.local and update with your real project credentials.
# Do NOT commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required for Live Database, Auth & Storage)
# Leave these unset to run the whole site in DEMO MODE (localStorage, sample data).
# ------------------------------------------------------------------------------
# Get these from your Supabase Project Settings -> API:
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-public-key

# Server-side only: Supabase Project Settings -> API -> service_role secret.
# Never prefix this variable with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ------------------------------------------------------------------------------
# 2. Transactional Email Configuration (Nodemailer SMTP)
# ------------------------------------------------------------------------------
# Used by /api/send-receipt to email automated receipts when an order is verified.
# If using Gmail, generate an App Password at:
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ieee.sb@bmsce.ac.in
SMTP_PASS=your-16-character-app-password
SMTP_FROM="BMSCE IEEE" <ieee.sb@bmsce.ac.in>

# ------------------------------------------------------------------------------
# 3. Google Sheets Integration
# ------------------------------------------------------------------------------
# Used to backup registrations into a Google Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
